    <style name="Theme.Echoes" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#101827</item>
        <item name="android:navigationBarColor">#101827</item>
        <item name="android:windowBackground">#101827</item>
        <item name="android:windowSplashScreenBackground">#101827</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
    </style>
</resources>
